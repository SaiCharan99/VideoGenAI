# =============================================================================
# VideoGenAI environment variables
# =============================================================================
# Copy this file to .env and fill in real values. Never commit .env.
# Keys are grouped by the phase that introduces them — you only need to fill
# in what the phase you are working on requires.
# =============================================================================

# -----------------------------------------------------------------------------
# Phase 1: Database (Neon Postgres)
# -----------------------------------------------------------------------------
# Create a free project at https://neon.tech, then copy the pooled connection
# string. Drizzle uses this for both runtime queries and migrations.
DATABASE_URL=

# -----------------------------------------------------------------------------
# Phase 2: Pipeline core (LLM + research)
# -----------------------------------------------------------------------------
# Anthropic API key — powers every agent in the pipeline.
# Get one at https://console.anthropic.com.
ANTHROPIC_API_KEY=

# Brave Search API — used by the researcher stage. Free tier is 2k queries/mo.
# Sign up at https://brave.com/search/api/.
BRAVE_SEARCH_API_KEY=

# Optional: Perplexity Sonar for higher-quality synthesis (used as fallback).
# https://docs.perplexity.ai/
PERPLEXITY_API_KEY=

# -----------------------------------------------------------------------------
# Phase 3: Cockpit + Inngest
# -----------------------------------------------------------------------------
# Local Inngest dev server runs without keys. For production deploys:
# https://www.inngest.com/docs
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Cockpit base URL — used by Inngest functions to call back into the web app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Phase 5: Asset generation + render
# -----------------------------------------------------------------------------
# ElevenLabs voice synthesis. https://elevenlabs.io/
ELEVENLABS_API_KEY=
# Default voice id (per channel override available in channel config).
ELEVENLABS_DEFAULT_VOICE_ID=

# Pexels stock footage + images. Free. https://www.pexels.com/api/
PEXELS_API_KEY=

# Replicate — used for Flux (stills) and Veo 3.1 (short b-roll clips).
# https://replicate.com/
REPLICATE_API_TOKEN=

# -----------------------------------------------------------------------------
# Phase 6: Publish
# -----------------------------------------------------------------------------
# YouTube Data API v3 OAuth — set up at https://console.cloud.google.com.
# The cockpit handles the OAuth flow; these are the app credentials.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Where Google redirects after consent — must match what you registered.
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# development | production
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
