{
  "name": "videogenai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end pipeline: one-line description → researched, scripted, animated, voiced YouTube video, with human-approval cockpit.",
  "license": "MIT",
  "author": "Sai Charan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaiCharan99/VideoGenAI.git"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --if-present dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "clean": "pnpm -r --if-present clean && rm -rf node_modules",
    "prepare": "husky",
    "db:generate": "pnpm --filter @videogenai/db db:generate",
    "db:migrate": "pnpm --filter @videogenai/db db:migrate",
    "db:studio": "pnpm --filter @videogenai/db db:studio",
    "db:push": "pnpm --filter @videogenai/db db:push",
    "channels:validate": "pnpm --filter @videogenai/channels validate"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
